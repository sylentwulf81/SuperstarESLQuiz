rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow get, create, update, delete: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      match /questionSets/{questionSetId} {
        allow get, update, delete: if isOwner(userId) && isValidId(userId) && isValidId(questionSetId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(questionSetId) && request.resource.data.userId == request.auth.uid;
      }
    }
  }
}
